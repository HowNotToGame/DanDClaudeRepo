{
  "permissions": {
    "allow": [
      "Bash(./dm:*)",
      "Bash(python3 -m robodm:*)",
      "Bash(python -m robodm:*)",
      "Bash(py -3 -m robodm:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python -m unittest:*)",
      "Bash(py -3 -m unittest:*)",
      "PowerShell(.\\dm:*)",
      "PowerShell(.\\dm.cmd:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/dm hook session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|mcp__.*([Ee]xec|[Rr]un|[Ss]hell|[Bb]ash|[Ee]val|[Pp]ython|[Tt]erminal|[Cc]ommand|[Ss]cript).*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/dm hook pretool"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/dm hook prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/dm hook stop"
          }
        ]
      }
    ]
  }
}
